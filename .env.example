# Copy to .env.local and adjust. Never commit real values.

# NestJS backend the server-side httpClient calls (server-only, never exposed
# to the browser). Defaults to http://localhost:5000 when unset.
API_BASE_URL=http://localhost:5000

# The platform's timezone: every date the panel shows, and every date filter
# it sends, is read in this zone. Defaults to Asia/Dhaka.
NEXT_PUBLIC_APP_TIME_ZONE=Asia/Dhaka
